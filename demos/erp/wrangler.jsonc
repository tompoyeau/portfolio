{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "demo-erp",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "picsou.topo-host.com", "custom_domain": true },
    { "pattern": "erp.topo-host.com", "custom_domain": true }
  ]
}
